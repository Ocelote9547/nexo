
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Nexo - Agenda de contactos</title>

  <meta name="description"
    content="Nexo, tu agenda local de contactos para Android.">

  <meta name="theme-color" content="#101827">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 25px;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, sans-serif;
      color: white;
      background: linear-gradient(135deg, #101827, #172b46);
    }

    .container {
      width: 100%;
      max-width: 480px;
      text-align: center;
      padding: 40px 25px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 25px;
      box-shadow: 0 15px 45px rgba(0,0,0,0.25);
    }

    .logo {
      width: 115px;
      height: 115px;
      object-fit: contain;
      border-radius: 25px;
    }

    h1 {
      font-size: 42px;
      margin: 20px 0 8px;
    }

    .subtitle {
      color: #60a5fa;
      font-size: 18px;
      font-weight: bold;
    }

    .description {
      color: #cbd5e1;
      line-height: 1.7;
      margin: 25px 0;
    }

    .download {
      display: block;
      background: #16a34a;
      color: white;
      text-decoration: none;
      padding: 17px;
      border-radius: 14px;
      font-size: 17px;
      font-weight: bold;
      transition: 0.2s;
    }

    .download:hover {
      background: #15803d;
      transform: translateY(-2px);
    }

    .details {
      color: #94a3b8;
      font-size: 13px;
      line-height: 1.8;
      margin-top: 20px;
    }

    footer {
      margin-top: 30px;
      color: #64748b;
      font-size: 12px;
    }
  </style>
</head>

<body>

  <main class="container">

    <img src="icon.png" class="logo" alt="Icono de Nexo">

    <h1>Nexo</h1>

    <div class="subtitle">
      Tu agenda local de contactos
    </div>

    <p class="description">
      Organiza y consulta tus contactos desde una
      aplicación sencilla para Android.
      Descubre Nexo y empieza a utilizarla.
    </p>

    <a class="download"
       href="https://github.com/TU_USUARIO/nexo/releases/latest/download/Nexo.apk">
       ↓ DESCARGAR NEXO
    </a>

    <div class="details">
      Versión 1.0.0<br>
      Android · Archivo APK<br>
      Descarga gratuita
    </div>

    <footer>
      © 2026 Nexo. Todos los derechos reservados.
    </footer>

  </main>

</body>
</html>
